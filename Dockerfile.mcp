FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV COLLABMD_URL=http://collabmd:1234
ENV MCP_TRANSPORT=streamable-http
ENV MCP_HOST=0.0.0.0
ENV MCP_PORT=8000

RUN uv pip install --system "mcp[cli]>=1.2,<2" "httpx>=0.27"

COPY mcp/collabmd-review/server.py ./server.py

EXPOSE 8000

CMD ["python3", "server.py"]
